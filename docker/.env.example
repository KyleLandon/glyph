# Production environment for docker-compose.prod.yml.
# Copy to .env in this directory and fill in real secrets. NEVER commit .env.

# Accepting the Minecraft EULA is required to run the backend.
EULA=true

GLYPH_SERVER_ID=glyph-01

GLYPH_DB_DATABASE=glyph
GLYPH_DB_USERNAME=glyph_app
# Generate: openssl rand -base64 24
GLYPH_DB_PASSWORD=

# Generate: openssl rand -base64 24
GLYPH_REDIS_PASSWORD=

# JVM heap sizes.
FOLIA_MEMORY=4G
VELOCITY_MEMORY=512M
